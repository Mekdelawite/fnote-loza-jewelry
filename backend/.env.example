# Replace DATABASE_URL and SECRET_KEY before starting the backend.
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/fnote_loza_db
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: used to seed one owner only when the database has no administrators.
# Existing administrator records and passwords are never changed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
